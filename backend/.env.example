# Copy this file to .env and fill in real values. Never commit .env.

PORT=4000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fieldforce

# Tokens — generate long random strings for production
JWT_ACCESS_SECRET=change-this-to-a-long-random-string
JWT_REFRESH_SECRET=change-this-to-a-different-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Default admin email used by `npm run db:init`. The password is asked for
# interactively — it is never stored in this file.
SEED_ADMIN_EMAIL=trtsindia@gmail.com

# Only used by `npm run db:seed` (the demo dataset). Not used in production.
SEED_ADMIN_PASSWORD=1234567

# Where selfies and face reference photos are written. On a platform with an
# ephemeral filesystem, point this at a mounted volume.
UPLOAD_DIR=uploads

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173
